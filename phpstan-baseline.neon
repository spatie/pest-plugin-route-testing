			message: '#^Parameter \#1 \$value of function collect expects Illuminate\\Contracts\\Support\\Arrayable\<\(int\|string\), mixed\>\|iterable\<\(int\|string\), mixed\>\|null, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/RouteResolver.php

		-
			message: '#^Property Spatie\\RouteTesting\\RouteResolver\:\:\$bindingNames \(array\<int, string\>\) does not accept array\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/RouteResolver.php

		-
			message: '#^Property Spatie\\RouteTesting\\RouteResolver\:\:\$exceptPaths \(array\<int, string\>\|null\) does not accept array\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/RouteResolver.php

		-
			message: '#^Property Spatie\\RouteTesting\\RouteResolver\:\:\$paths \(array\<int, string\>\|null\) does not accept array\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/RouteResolver.php

		-
			message: '#^Unable to resolve the template type TKey in call to function collect$#'
			identifier: argument.templateType
			count: 1
			path: src/RouteResolver.php

		-
			message: '#^Unable to resolve the template type TValue in call to function collect$#'
			identifier: argument.templateType
			count: 1
